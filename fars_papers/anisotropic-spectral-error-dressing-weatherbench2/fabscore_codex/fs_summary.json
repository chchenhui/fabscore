    "figures": [
        {
            "claim_index": 19,
            "claim": "19. Figure 1: Overview of Anisotropic Spectral Error Dressing (ASED). Given a deterministic GraphCast forecast, ASED: (1) computes spherical harmonic coefficients of historical residuals, (2) estimates degree spectrum C_l and within-degree anisotropy weights w_µ across 3 µ-bins and 4 degree bands, (3) generates M = 50 ensemble members by sampling Gaussian perturbations with the calibrated anisotropic spectral structure.",
            "verdict": "Verified",
            "explanation": "Analysis stage: The Figure 1 method description is directly supported by the implementation: `run_ased_optimized.py` sets `N_MEMBERS = 50`, `N_MU_BINS = 3`, and `N_ANISO_BANDS = 4`; `ASEDSampler.estimate_anisotropy_profile` computes SH-based anisotropy weights from historical residuals; and `ASEDSampler.sample_perturbations` draws Gaussian perturbations in spectral space.",
            "evidence": "exp/ased/scripts/run_ased_optimized.py; exp/ased/perturbations/ased.py; exp/ased/spectral/sht_utils.py; exp/EXPERIMENT_RESULTS/ased_main/RESULTS.json",
            "detection_mode": "static_code_analysis",
            "decision_stage": "analysis",
            "analysis_classification": {
