% Simplified Agents4Science style - fallback version
% Based on standard article format with minimal modifications
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{agents4science_2025}[2025/09/15 Simple agents4science style]

% Basic packages
\RequirePackage{geometry}
\RequirePackage{natbib}

% Page geometry
\geometry{
  letterpaper,
  textheight=9in,
  textwidth=5.5in,
  top=1in,
  headheight=12pt,
  headsep=25pt,
  footskip=30pt
}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries \@title \par}
    \vskip 1.5em%
    {\large \@author \par}
    \vskip 1em%
  \end{center}
}

% Abstract environment
\renewenvironment{abstract}{%
  \small
  \begin{center}%
    {\bfseries Abstract\vspace{-.5em}\vspace{\z@}}%
  \end{center}%
  \quotation
}{%
  \endquotation
}

\endinput